    "@fal-ai/client": "^1.5.0",
    "@sparticuz/chromium": "^138.0.2",
    "express": "^4.21.2",
    "fabric": "^6.7.1",
    "fflate": "^0.8.2",
    "ffmpeg-static": "^5.2.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "puppeteer-core": "^24.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^6.3.5",
    "@vitejs/plugin-react": "^4.7.0"
