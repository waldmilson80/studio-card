{
  "name": "studio-card",
  "version": "2.0.0",
  "private": true,
  "description": "Studio Card do Central Goiano: editor visual de artes e vídeo/Reels integrado ao sistema existente",
  "main": "index.js",
  "scripts": {
    "build": "vite build frontend --config frontend/vite.config.js",
